{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"linter": {
		"enabled": true,
		"rules": { "preset": "none" }
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": { "organizeImports": "on" }
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "scripts/**/*.ts", "env.d.ts"]
	}
}
